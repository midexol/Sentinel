# ---- Network -------------------------------------------------------------
# sepolia (Base Sepolia, chain 84532) or mainnet (Base, chain 8453)
CHAIN=sepolia
# Defaults to https://sepolia.base.org / https://mainnet.base.org for the chosen CHAIN
RPC_URL=https://sepolia.base.org

# ---- Wallet ---------------------------------------------------------------
# Address Sentinel protects (required)
WALLET_ADDRESS=
# Signing key used ONLY to resubmit stuck transactions. Leave empty for read-only mode.
# Must be 0x + 64 hex characters; a malformed value is a startup error.
PRIVATE_KEY=

# ---- Behaviour (env overrides settings.json) -------------------------------
GAP_DETECTION_INTERVAL_MS=500
EVICTION_TIMEOUT_MS=30000
MAX_EVICTION_RESUBMISSIONS=3
EVICTION_BACKOFF_MULTIPLIER=1.5
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_WINDOW_MS=300000
CIRCUIT_BREAKER_COOLDOWN_MS=60000
CIRCUIT_BREAKER_AUTO_RECOVERY=true
# Minimum is 10 (Base's replacement rule); min must not exceed max
MIN_GAS_BUMP_PCT=10
MAX_GAS_BUMP_PCT=50
# Headroom multiplier on the base fee when computing maxFeePerGas
BASE_FEE_MULTIPLIER=2
# Sentinel refuses to broadcast a replacement whose maxFeePerGas exceeds this
MAX_GAS_PRICE_CAP_GWEI=100
# true = detect and diagnose real gaps but never broadcast
DRY_RUN=false

# ---- Logging / state -------------------------------------------------------
LOG_FILE=./sentinel.log
LOG_ROTATION=true
MAX_LOG_SIZE_MB=100
LOG_RETENTION_DAYS=7
# Shared by the proxy and watchdog processes (tracked txs + circuit breaker). Empty = in-memory only.
STATE_FILE=./sentinel-state.json
# Webhook for alerts (Discord/Slack/generic). More can be set in settings.json.
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=30000

# ---- AI diagnosis (optional) ----------------------------------------------
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5-5
AGENT_MODEL=claude-sonnet-5-5

# ---- RPC proxy ------------------------------------------------------------
# Loopback by default. If you bind elsewhere (e.g. 0.0.0.0 in Docker) SET A TOKEN.
PROXY_HOST=127.0.0.1
PROXY_PORT=8545
# When set, clients must send "Authorization: Bearer <token>"
PROXY_AUTH_TOKEN=
# Comma-separated browser origins allowed to call the proxy (default: none)
PROXY_ALLOWED_ORIGINS=

# ---- Web dashboard --------------------------------------------------------
# Required to change settings or send test alerts from the dashboard (Bearer token).
# If unset, settings are read-only in production.
SETTINGS_ADMIN_TOKEN=
# Optional: dashboard chain for explorer links / RPC reads (defaults to CHAIN)
NEXT_PUBLIC_CHAIN=sepolia
